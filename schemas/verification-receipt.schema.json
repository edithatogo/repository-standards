{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/edithatogo/repository-standards/schemas/verification-receipt.schema.json",
  "title": "Repository verification receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repository", "revision", "generated_at", "result", "checks"],
  "properties": {
    "schema_version": {"const": 1},
    "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
    "revision": {"type": "string", "minLength": 7},
    "generated_at": {"type": "string", "format": "date-time"},
    "seed": {"type": ["integer", "string", "null"]},
    "result": {"enum": ["pass", "fail", "partial"]},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "result"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "result": {"enum": ["pass", "fail", "skip"]},
          "duration_seconds": {"type": "number", "minimum": 0},
          "evidence": {"type": "string"},
          "reason": {"type": "string"}
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}
        }
      }
    }
  }
}
