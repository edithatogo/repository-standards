{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Community bootstrap audit policy version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "required",
    "recommended",
    "environment_configuration",
    "devcontainer",
    "template_repository",
    "issue_form_kinds"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "required": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "readme",
          "contributing",
          "code_of_conduct",
          "security",
          "support",
          "issue_templates",
          "issue_chooser",
          "pull_request_template",
          "agents",
          "workflows",
          "dependency_updates",
          "gitignore",
          "editorconfig",
          "env_example",
          "devcontainer",
          "discussion_templates",
          "template_repository"
        ]
      }
    },
    "recommended": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "readme",
          "contributing",
          "code_of_conduct",
          "security",
          "support",
          "issue_templates",
          "issue_chooser",
          "pull_request_template",
          "agents",
          "workflows",
          "dependency_updates",
          "gitignore",
          "editorconfig",
          "env_example",
          "devcontainer",
          "discussion_templates",
          "template_repository"
        ]
      }
    },
    "environment_configuration": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "devcontainer": {
      "enum": [
        "required",
        "optional"
      ]
    },
    "template_repository": {
      "type": "boolean"
    },
    "issue_form_kinds": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z_]*$"
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "issue_form_kinds": {"maxProperties": 0}
        }
      },
      "then": {
        "properties": {
          "required": {
            "const": [
              "readme", "contributing", "code_of_conduct", "security",
              "issue_templates", "pull_request_template"
            ]
          },
          "recommended": {"maxItems": 0}
        }
      }
    }
  ]
}
